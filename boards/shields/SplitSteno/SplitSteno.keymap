#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    combos {
        compatible = "zmk,combos";
        combo_bt_layer {
            timeout-ms = <50>;
            key-positions = <0 1 2 3 4>; 
            bindings = <&mo 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            bindings = <
                &kp S    &kp T    &kp P    &kp H    &kp ASTERISK    &kp F    &kp P    &kp L    &kp T    &kp D
                &kp S    &kp K    &kp W    &kp R    &kp ASTERISK    &kp R    &kp B    &kp G    &kp S    &kp Z
                                           &bt BT_CLR_ALL    &kp O    &kp E    &kp U
            >;
        };

        bt_layer { // Layer 1
            bindings = <
                &none    &none    &none    &none    &none           &none    &none    &none    &none    &none
                &none    &none    &none    &none    &none           &none    &none    &none    &none    &none
                                           &bt BT_CLR_ALL    &bt BT_PRV    &bt BT_NXT    &none
            >;
        };
    };
};
